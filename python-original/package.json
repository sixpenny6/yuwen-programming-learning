{
  "name": "python-learning",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.js",
  "author": "Your Name",
  "description": "像学习语文一样学习编程",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite",
    "electron:dev": "cross-env IS_ELECTRON=true concurrently \"npm run dev\" \"wait-on http://localhost:9001 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "cross-env IS_ELECTRON=true npm run build && electron-builder",
    "check:source": "node scripts/verify-source.cjs"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.8",
    "@google/genai": "^1.30.0",
    "@uiw/codemirror-theme-github": "^4.25.3",
    "@uiw/react-codemirror": "^4.25.3",
    "electron-is-dev": "^3.0.1",
    "openai": "^6.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@codemirror/autocomplete": "6.20.0",
    "@uiw/codemirror-themes": "4.25.3",
    "@lezer/highlight": "1.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.3.0",
    "vite": "^6.2.0",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.pythonlearning.app",
    "productName": "像学习语文一样学习编程",
    "asar": true,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "asarUnpack": [
      "dist/audio/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "语文式 Python 学习",
      "perMachine": true,
      "allowElevation": true
    }
  }
}
